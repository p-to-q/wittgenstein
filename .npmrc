auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
engine-strict=true

# The reproducible baseline is CPU-only. Keep the packaged CPU runtime and
# skip the optional CUDA download; an explicit ONNXRUNTIME_NODE_INSTALL_CUDA
# environment variable still overrides this setting for a GPU host.
onnxruntime-node-install-cuda=skip
